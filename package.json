{
  "name": "anima-list",
  "version": "1.2.0",
  "description": "Anima List - 记录你的动漫观看进度",
  "author": "",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.animetracker.desktop",
    "productName": "Anima List",
    "directories": {
      "app": ".",
      "output": ".desktop-build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "!android/**/*",
      "!www/**/*",
      "!tests/**/*",
      "!docs/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": ["dir"]
    },
    "nsis": {
      "artifactName": "Anima-List-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Anima List"
    }
  },
  "scripts": {
    "dev": "vite",
    "sync:version": "node scripts/sync-version.mjs",
    "prebuild": "node scripts/sync-version.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:preview": "npm run build && electron-builder --win dir && node scripts/flatten-desktop-build.mjs",
    "desktop:installer": "npm run build && electron-builder --win nsis",
    "android:release": "npm run sync && node scripts/create-release-keystore.mjs && cd android && gradlew.bat assembleRelease",
    "lint": "node scripts/check-source.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "test": "node tests/run-tests.mjs",
    "check": "npm run lint && npm run test && npm run build && npm run check:dist",
    "android": "npx cap add android",
    "ios": "npx cap add ios",
    "sync": "npm run build && npm run check:dist && npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "vite": "^5.1.0"
  }
}
